# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=https://rfil-api.sudeepdhakal.workers.dev
NEXT_PUBLIC_SITE_URL=https://reliancenepal.com.np

# ── Cloudflare (deployment / wrangler) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_MEDIA=rfil-media
CLOUDFLARE_R2_BUCKET_DOCUMENTS=rfil-documents
CLOUDFLARE_QUEUE_EMAIL=rfil-email-queue

# ── API Environment ──
JWT_SECRET=change-this-to-a-random-secret
SITE_URL=https://rfil-api.sudeepdhakal.workers.dev
ADMIN_EMAIL=info@reliancenepal.com.np
FROM_EMAIL=noreply@reliancenepal.com.np

# ── Email (Cloudflare Email Routing binding) ──
# SEND_EMAIL is a Cloudflare binding, not a plain env var.
# Configure it in wrangler.jsonc under "send_email" bindings.

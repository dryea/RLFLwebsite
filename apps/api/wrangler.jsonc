{
  "name": "rfil-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "migrations_dir": "drizzle",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rfil-db",
      "database_id": "0d0bfcb4-7ac6-4e10-a62b-79f32d234c7c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "rfil-media"
    },
    {
      "binding": "R2_DOCUMENTS",
      "bucket_name": "rfil-documents"
    }
  ],
  "queues": {
    "producers": [{
      "binding": "EMAIL_QUEUE",
      "queue": "rfil-email-queue"
    }]
  },
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "vars": {
    "SITE_URL": "https://reliancenepal.com.np",
    "ADMIN_EMAIL": "info@reliancenepal.com.np",
    "FROM_EMAIL": "noreply@reliancenepal.com.np",
    "JWT_SECRET": "rfil-jwt-secret-2026"
  }
}

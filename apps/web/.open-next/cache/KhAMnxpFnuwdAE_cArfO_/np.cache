m text-gray-500 transition-colors hover:bg-primary-50 hover:text-primary-500 hover:border-primary-500/20\" href=\"/products/loans/home-loan\">Home &amp; Land Loans<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3 w-3 text-secondary-500 transition-transform group-hover:translate-x-0.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></li><li><a class=\"flex items-center justify-between rounded-lg border border-gray-100 bg-gray-50 px-3 py-2 text-sm font-medium text-gray-500 transition-colors hover:bg-primary-50 hover:text-primary-500 hover:border-primary-500/20\" href=\"/products/loans/business-loan\">Business &amp; SME Credits<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3 w-3 text-secondary-500 transition-transform group-hover:translate-x-0.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></li></ul><a class=\"btn btn-primary service-card-cta mt-auto w-full text-center font-bold\" href=\"/products/loans\">Explore Credit Options</a></div><div class=\"service-card group relative flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-primary-500 hover:shadow-lg\"><div class=\"service-card-icon-wrapper mb-5 flex h-[60px] w-[60px] items-center justify-center rounded-xl bg-primary-50 transition-all duration-300 group-hover:bg-secondary-500\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wallet h-7 w-7 text-primary-500 transition-all duration-300 group-hover:text-white\"><path d=\"M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1\"></path><path d=\"M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4\"></path></svg></div><h3 class=\"mb-3 font-heading text-xl font-extrabold text-primary-500 flex items-center justify-between\">डिजिटल च्यानलहरू<span class=\"service-card-counter ml-2 rounded-full bg-gray-100 px-2 py-0.5 text-[0.75rem] font-bold text-gray-500\">२४/७ पहुँच</span></h3><p class=\"mb-5 text-sm leading-relaxed text-gray-500\">आधुनिक मोबाइल वालेट, फोनपे क्यूआर स्क्यानिङ र अनलाइन रेमिट्यान्स पोर्टलको साथ सुरक्षित रूपमा खाता व्यवस्थापन गर्नुहोस्।</p><ul class=\"service-links-list mb-5 flex flex-col gap-2\"><li><a class=\"flex items-center justify-between rounded-lg border border-gray-100 bg-gray-50 px-3 py-2 text-sm font-medium text-gray-500 transition-colors hover:bg-primary-50 hover:text-primary-500 hover:border-primary-500/20\" href=\"/services/mobile-banking\">Smart Mobile Banking<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3 w-3 text-secondary-500 transition-transform group-hover:translate-x-0.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></li><li><a class=\"flex items-center justify-between rounded-lg border border-gray-100 bg-gray-50 px-3 py-2 text-sm font-medium text-gray-500 transition-colors hover:bg-primary-50 hover:text-primary-500 hover:border-primary-500/20\" href=\"/services/connect-ips\">connectIPS Transfers<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3 w-3 text-secondary-500 transition-transform group-hover:translate-x-0.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></li></ul><div class=\"service-mini-widget rounded-lg bg-gray-50 p-3 mb-5 border border-gray-100\"><div class=\"widget-title flex items-center justify-between mb-2\"><span class=\"text-[0.75rem] font-extrabold uppercase tracking-wider text-gray-400\">Feature Benefits</span><span class=\"inline-block h-[6px] w-[6px] rounded-full bg-green-500 animate-pulse\"></span></div><div class=\"widget-tabs flex gap-1 mb-2\"><button class=\"widget-tab-btn flex-1 rounded border px-1 py-1 text-[0.7rem] font-bold transition-colors bg-primary-500 text-white border-primary-500\">Mobile</button><button class=\"widget-tab-btn flex-1 rounded border px-1 py-1 text-[0.7rem] font-bold transition-colors bg-white text-gray-500 border-gray-200 hover:bg-gray-100\">connectIPS</button><button class=\"widget-tab-btn flex-1 rounded border px-1 py-1 text-[0.7rem] font-bold transition-colors bg-white text-gray-500 border-gray-200 hover:bg-gray-100\">QR Pay</button></div><div class=\"widget-result-panel rounded border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-primary-500 text-center\">✓ Fonepay QR ✓ Bills ✓ Real-time Pay</div></div><a class=\"btn btn-primary service-card-cta mt-auto w-full text-center font-bold\" href=\"/services\">Explore Services</a></div><div class=\"service-card group relative flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-primary-500 hover:shadow-lg\"><div class=\"service-card-icon-wrapper mb-5 flex h-[60px] w-[60px] items-center justify-center rounded-xl bg-primary-50 transition-all duration-300 group-hover:bg-secondary-500\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-handshake h-7 w-7 text-primary-500 transition-all duration-300 group-hover:text-white\"><path d=\"m11 17 2 2a1 1 0 1 0 3-3\"></path><path d=\"m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4\"></path><path d=\"m21 3 1 11h-2\"></path><path d=\"M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3\"></path><path d=\"M3 4h8\"></path></svg></div><h3 class=\"mb-3 font-heading text-xl font-extrabold text-primary-500 flex items-center justify-between\">अफर र सञ्जाल<span class=\"service-card-counter ml-2 rounded-full bg-gray-100 px-2 py-0.5 text-[0.75rem] font-bold text-gray-500\">२१ शाखाहरू</span></h3><p class=\"mb-5 text-sm leading-relaxed text-gray-500\">देशभर शाखाहरू पत्ता लगाउनुहोस् र आरएफएल कार्ड धारकहरूको लागि विशेष छुट प्रदान गर्ने व्यापारी साझेदार आउटलेटहरूको आनन्द लिनुहोस्।</p><ul class=\"service-links-list mb-5 flex flex-col gap-2\"><li><a class=\"flex items-center justify-between rounded-lg border border-gray-100 bg-gray-50 px-3 py-2 text-sm font-medium text-gray-500 transition-colors hover:bg-primary-50 hover:text-primary-500 hover:border-primary-500/20\" href=\"/branches\">Merchant Discounts<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3 w-3 text-secondary-500 transition-transform group-hover:translate-x-0.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></li><li><a class=\"flex items-center justify-between rounded-lg border border-gray-100 bg-gray-50 px-3 py-2 text-sm font-medium text-gray-500 transition-colors hover:bg-primary-50 hover:text-primary-500 hover:border-primary-500/20\" href=\"/branches#partners\">Clearing &amp; Tieups<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3 w-3 text-secondary-500 transition-transform group-hover:translate-x-0.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></li></ul><a class=\"btn btn-primary service-card-cta mt-auto w-full text-center font-bold\" href=\"/branches\">Locate Branches</a></div></div></div></section><section class=\"section bg-white\"><div class=\"container-page\"><div class=\"about-section-grid grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]\"><div class=\"about-text-content\"><h4 class=\"mb-2 text-xs font-bold uppercase tracking-[0.1em] text-secondary-500\">परिचय</h4><h2 class=\"relative mb-6 pb-3 text-3xl font-bold text-primary-800 after:absolute after:bottom-0 after:left-0 after:h-1 after:w-16 after:rounded-full after:bg-secondary-500 md:text-4xl\">एक दशक भन्दा बढीको विश्वसनीय वित्तीय साझेदार</h2><p class=\"mb-6 text-[1.05rem] leading-relaxed text-gray-500\">रिलायन्स फाइनान्स लिमिटेड, इजाजतपत्र प्राप्त &#x27;ग&#x27; वर्गको वित्तीय संस्था, वि.सं. २०६६ मा स्थापना भएको थियो। विविध व्यवसायिक नेताहरू र बैंकरहरूको अत्यधिक योग्य टोलीद्वारा प्रवर्द्धित, हामीले नेपालमा विश्वास र वित्तीय सुदृढताको विरासत निर्माण गरेका छौं।</p><p class=\"mb-6 text-[1.05rem] leading-relaxed text-gray-500\">हाम्रा सञ्चालक समितिको दृष्टिकोण र ग्राहकको वफादारीबाट प्रेरित भई, हामी देशभरका शाखाहरूको विस्तृत नेटवर्क मार्फत बलियो खुद्रा बैंकिङ, ऋण र कर्पोरेट समाधानहरू प्रदान गर्दछौं।</p><div class=\"stats-grid mt-8 grid grid-cols-3 gap-5\"><div class=\"stat-item relative overflow-hidden rounded-xl border border-gray-100 bg-gray-50 p-5 text-center\"><div class=\"absolute bottom-0 left-0 h-1 w-full bg-secondary-500\"></div><div class=\"text-3xl font-extrabold text-primary-500 lg:text-4xl\">21<!-- -->+</div><div class=\"mt-1 text-sm font-medium text-gray-500\">सक्रिय शाखाहरू</div></div><div class=\"stat-item relative overflow-hidden rounded-xl border border-gray-100 bg-gray-50 p-5 text-center\"><div class=\"absolute bottom-0 left-0 h-1 w-full bg-secondary-500\"></div><div class=\"text-3xl font-extrabold text-primary-500 lg:text-4xl\">100k<!-- -->+</div><div class=\"mt-1 text-sm font-medium text-gray-500\">सन्तुष्ट ग्राहकहरू</div></div><div class=\"stat-item relative overflow-hidden rounded-xl border border-gray-100 bg-gray-50 p-5 text-center\"><div class=\"absolute bottom-0 left-0 h-1 w-full bg-secondary-500\"></div><div class=\"text-3xl font-extrabold text-primary-500 lg:text-4xl\">17<!-- -->+</div><div class=\"mt-1 text-sm font-medium text-gray-500\">वर्षको विरासत</div></div></div><a class=\"btn btn-primary mt-8 inline-flex\" href=\"/np/about/introduction\">हाम्रो बारेमा थप पढ्नुहोस्</a></div><div class=\"about-image-frame relative\"><img src=\"https://reliancenepal.com.np/uploads/page/48141a0a9b0736d944baf8fb179564c1b770f3f9.jpg\" alt=\"Reliance Finance\" class=\"w-full rounded-xl\"/><div class=\"about-image-overlay-card absolute -bottom-4 -left-4 max-w-[220px] rounded-xl bg-primary-500 p-5 text-white shadow-lg\"><div class=\"text-3xl font-extrabold text-secondary-500 lg:text-4xl\">वि.सं. २०६६</div><p class=\"mt-1 text-xs leading-relaxed text-white\">नेपाल राष्ट्र बैंकद्वारा स्थापित र इजाजतपत्र प्राप्त।</p></div></div></div></div></section><section class=\"section bg-white\"><div class=\"container-page\"><div class=\"section-header\"><h2>द्रुत ऋण EMI अनुमानक</h2><p>आफ्नो खर्च कुशलतापूर्वक योजना गर्नुहोस्। आफ्नो मासिक किस्ताको द्रुत अनुमान प्राप्त गर्न तलका स्लाइडरहरू समायोजन गर्नुहोस्।</p></div><div class=\"jsx-84d56e359ee540fa grid gap-8 lg:grid-cols-2\"><div class=\"jsx-84d56e359ee540fa rounded-xl border bg-white p-6 shadow-sm\"><div class=\"jsx-84d56e359ee540fa space-y-5\"><div class=\"jsx-84d56e359ee540fa\"><label class=\"jsx-84d56e359ee540fa mb-1 flex justify-between text-sm font-medium text-gray-700\"><span class=\"jsx-84d56e359ee540fa\">Loan Amount</span><span class=\"jsx-84d56e359ee540fa font-semibold text-primary-700\">Rs. <!-- -->1,000,000</span></label><input type=\"range\" min=\"100000\" max=\"10000000\" step=\"50000\" class=\"jsx-84d56e359ee540fa emi-slider w-full\" value=\"1000000\"/><div class=\"jsx-84d56e359ee540fa flex justify-between text-xs text-gray-400\"><span class=\"jsx-84d56e359ee540fa\">Rs. 1L</span><span class=\"jsx-84d56e359ee540fa\">Rs. 1Cr</span></div></div><div class=\"jsx-84d56e359ee540fa\"><label class=\"jsx-84d56e359ee540fa mb-1 flex justify-between text-sm font-medium text-gray-700\"><span class=\"jsx-84d56e359ee540fa\">Interest Rate</span><span class=\"jsx-84d56e359ee540fa font-semibold text-primary-700\">12<!-- -->%</span></label><input type=\"range\" min=\"1\" max=\"30\" step=\"0.5\" class=\"jsx-84d56e359ee540fa emi-slider w-full\" value=\"12\"/><div class=\"jsx-84d56e359ee540fa flex justify-between text-xs text-gray-400\"><span class=\"jsx-84d56e359ee540fa\">1%</span><span class=\"jsx-84d56e359ee540fa\">30%</span></div></div><div class=\"jsx-84d56e359ee540fa\"><label class=\"jsx-84d56e359ee540fa mb-1 flex justify-between text-sm font-medium text-gray-700\"><span class=\"jsx-84d56e359ee540fa\">Tenure</span><span class=\"jsx-84d56e359ee540fa font-semibold text-primary-700\">60<!-- --> months (<!-- -->5<!-- -->y <!-- -->0<!-- -->m)</span></label><input type=\"range\" min=\"6\" max=\"360\" step=\"6\" class=\"jsx-84d56e359ee540fa emi-slider w-full\" value=\"60\"/><div class=\"jsx-84d56e359ee540fa flex justify-between text-xs text-gray-400\"><span class=\"jsx-84d56e359ee540fa\">6 months</span><span class=\"jsx-84d56e359ee540fa\">30 years</span></div></div></div></div><div class=\"jsx-84d56e359ee540fa rounded-xl border bg-white p-6 shadow-sm\"><div class=\"jsx-84d56e359ee540fa mb-6 grid grid-cols-3 gap-3\"><div class=\"jsx-84d56e359ee540fa rounded-lg bg-primary-50 p-3 text-center\"><p class=\"jsx-84d56e359ee540fa text-xs text-gray-500\">Monthly EMI</p><p class=\"jsx-84d56e359ee540fa text-xl font-bold text-primary-700\">Rs. <!-- -->22,244</p></div><div class=\"jsx-84d56e359ee540fa rounded-lg bg-amber-50 p-3 text-center\"><p class=\"jsx-84d56e359ee540fa text-xs text-gray-500\">Total Interest</p><p class=\"jsx-84d56e359ee540fa text-xl font-bold text-amber-700\">Rs. <!-- -->334,667</p></div><div class=\"jsx-84d56e359ee540fa rounded-lg bg-green-50 p-3 text-center\"><p class=\"jsx-84d56e359ee540fa text-xs text-gray-500\">Total Payment</p><p class=\"jsx-84d56e359ee540fa text-xl font-bold text-green-700\">Rs. <!-- -->1,334,667</p></div></div><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><!--/$--><a class=\"mt-4 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-semibold text-white transition-all hover:bg-primary-600\" href=\"/emi-calculator\">Full EMI Calculator<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><section class=\"section bg-surface-alt\"><div class=\"container-page\"><div class=\"section-header\"><h2>पछिल्लो हाइलाइट्स र कार्यक्रमहरू</h2><p>हाम्रो हालैका कर्पोरेट घोषणाहरू, सामुदायिक सेवाहरू र सार्वजनिक सूचनाहरूसँग अद्यावधिक रहनुहोस्।</p></div><div><div class=\"mb-8 flex justify-center gap-2\"><button class=\"rounded-lg px-6 py-2.5 font-heading font-semibold transition-all bg-primary-500 text-white shadow-md\">पछिल्लो समाचार</button><button class=\"rounded-lg px-6 py-2.5 font-heading font-semibold transition-all bg-white text-gray-600 hover:bg-primary-50\">कार्यक्रमहरू</button></div><div class=\"grid gap-6 md:grid-cols-2 lg:grid-cols-4\"><a class=\"group relative overflow-hidden rounded-xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg\" href=\"/np/news/q3-results\"><div class=\"flex h-44 items-end bg-gradient-to-t from-primary-900/80 via-primary-900/40 to-primary-700/20 bg-cover bg-center\" style=\"background-image:linear-gradient(135deg, #702B86 0%, #5a226b 100%)\"><div class=\"p-4\"><span class=\"inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1 text-xs font-medium text-white backdrop-blur\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar h-3 w-3\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg>2025-03-15</span></div></div><div class=\"p-4\"><h3 class=\"mb-2 line-clamp-2 font-heading font-bold text-gray-900 transition-colors group-hover:text-primary-700\">Reliance Finance announces Q3 financial results with strong growth</h3><span class=\"inline-flex items-center gap-1 text-xs font-semibold text-primary-700 group-hover:text-secondary-600\">थप पढ्नुहोस्<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></span></div></a><a class=\"group relative overflow-hidden rounded-xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg\" href=\"/np/news/pokhara-branch\"><div class=\"flex h-44 items-end bg-gradient-to-t from-primary-900/80 via-primary-900/40 to-primary-700/20 bg-cover bg-center\" style=\"background-image:linear-gradient(135deg, #702B86 0%, #5a226b 100%)\"><div class=\"p-4\"><span class=\"inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1 text-xs font-medium text-white backdrop-blur\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar h-3 w-3\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg>2025-02-28</span></div></div><div class=\"p-4\"><h3 class=\"mb-2 line-clamp-2 font-heading font-bold text-gray-900 transition-colors group-hover:text-primary-700\">New branch inaugurated in Pokhara to expand service network</h3><span class=\"inline-flex items-center gap-1 text-xs font-semibold text-primary-700 group-hover:text-secondary-600\">थप पढ्नुहोस्<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></span></div></a><a class=\"group relative overflow-hidden rounded-xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg\" href=\"/np/news/mobile-banking-update\"><div class=\"flex h-44 items-end bg-gradient-to-t from-primary-900/80 via-primary-900/40 to-primary-700/20 bg-cover bg-center\" style=\"background-image:linear-gradient(135deg, #702B86 0%, #5a226b 100%)\"><div class=\"p-4\"><span class=\"inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1 text-xs font-medium text-white backdrop-blur\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar h-3 w-3\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg>2025-02-10</span></div></div><div class=\"p-4\"><h3 class=\"mb-2 line-clamp-2 font-heading font-bold text-gray-900 transition-colors group-hover:text-primary-700\">Reliance Finance launches enhanced mobile banking platform</h3><span class=\"inline-flex items-center gap-1 text-xs font-semibold text-primary-700 group-hover:text-secondary-600\">थप पढ्नुहोस्<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></span></div></a><a class=\"group relative overflow-hidden rounded-xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg\" href=\"/np/news/financial-literacy\"><div class=\"flex h-44 items-end bg-gradient-to-t from-primary-900/80 via-primary-900/40 to-primary-700/20 bg-cover bg-center\" style=\"background-image:linear-gradient(135deg, #702B86 0%, #5a226b 100%)\"><div class=\"p-4\"><span class=\"inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1 text-xs font-medium text-white backdrop-blur\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar h-3 w-3\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg>2025-01-20</span></div></div><div class=\"p-4\"><h3 class=\"mb-2 line-clamp-2 font-heading font-bold text-gray-900 transition-colors group-hover:text-primary-700\">Financial literacy program reaches 5,000 students across Nepal</h3><span class=\"inline-flex items-center gap-1 text-xs font-semibold text-primary-700 group-hover:text-secondary-600\">थप पढ्नुहोस्<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link h-3 w-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></span></div></a></div></div></div></section><section class=\"section bg-white\"><div class=\"container-page\"><div class=\"section-header\"><h2>कर्पोरेट सामाजिक उत्तरदायित्व</h2><p>जहाँ महत्त्व छ त्यहाँ परिवर्तन ल्याउँदै। हामी नेपालभर सार्वजनिक स्वास्थ्य, शिक्षा र राहत प्रयासहरू बढाउन प्रतिबद्ध छौं।</p></div><div class=\"grid gap-6 md:grid-cols-2 lg:grid-cols-4\"><div class=\"group relative overflow-hidden rounded-xl border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg\" style=\"border-top:3px solid transparent\"><div class=\"mb-4 flex h-[60px] w-[60px] items-center justify-center rounded-xl bg-red-50 text-red-500 transition-all duration-300 group-hover:bg-red-500 group-hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart h-7 w-7\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"></path></svg></div><h3 class=\"mb-2 font-heading text-lg font-bold text-gray-900\">कोहलपुर शाखा कोभिड खाद्य बैंक राहत अभियान</h3><p class=\"mb-4 text-sm leading-relaxed text-gray-500\"></p><a class=\"inline-flex items-center gap-1 text-sm font-semibold text-primary-700 transition-colors hover:text-secondary-600\" href=\"/np/csr\">थप जान्नुहोस्<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"group relative overflow-hidden rounded-xl border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg\" style=\"border-top:3px solid transparent\"><div class=\"mb-4 flex h-[60px] w-[60px] items-center justify-center rounded-xl bg-red-50 text-red-500 transition-all duration-300 group-hover:bg-red-500 group-hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart h-7 w-7\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"></path></svg></div><h3 class=\"mb-2 font-heading text-lg font-bold text-gray-900\">निःशुल्क आँखा जाँच र मोतियाबिन्दु शल्यक्रिया शिविर</h3><p class=\"mb-4 text-sm leading-relaxed text-gray-500\"></p><a class=\"inline-flex items-center gap-1 text-sm font-semibold text-primary-700 transition-colors hover:text-secondary-600\" href=\"/np/csr\">थप जान्नुहोस्<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"group relative overflow-hidden rounded-xl border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg\" style=\"border-top:3px solid transparent\"><div class=\"mb-4 flex h-[60px] w-[60px] items-center justify-center rounded-xl bg-red-50 text-red-500 transition-all duration-300 group-hover:bg-red-500 group-hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 
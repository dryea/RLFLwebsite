{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/about/layout,_N_T_/[lang]/about/mission-goals/layout,_N_T_/[lang]/about/mission-goals/page,_N_T_/np/about/mission-goals"}},"html":"<!DOCTYPE html><!--QnW1E944dh1kNMlqd4nc4--><html lang=\"en\" class=\"__variable_ed3508 __variable_f367f3 font-body antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/7b0b24f36b1a6d0b-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"https://reliancenepal.com.np/assets/images/reliance/en_flag.png\"/><link rel=\"preload\" as=\"image\" href=\"https://reliancenepal.com.np/assets/images/reliance/logo.png\"/><link rel=\"stylesheet\" href=\"/_next/static/css/bc89be2ade82c417.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-7a5767218c485cdf.js\"/><script src=\"/_next/static/chunks/4bd1b696-100b9d70ed4e49c1.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-1a98a701e05520f3.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-236ed5ed9abbb4cf.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-3773513dd40498bb.js\" async=\"\"></script><script src=\"/_next/static/chunks/6388-76b7a898aa59fe46.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/%5Blang%5D/layout-53d02a29fc0601a2.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"theme-color\" content=\"#1a365d\"/><title>लक्ष्य र उद्देश्य | Reliance Finance Limited</title><meta name=\"description\" content=\"रिलायन्स फाइनान्स लिमिटेडको मिशन, दृष्टिक